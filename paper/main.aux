\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces EchoKV preserves FP16 accuracy while reducing KV memory by $59$--$75\%$ across four workloads. \emph  {Bits/rank} = per-TP-rank average at end of run with the controller live; \emph  {Consolidated} = per-layer max across ranks. $\Delta $ is paired vs FP16 with McNemar exact $p$. $\tau $-Bench numbers merge airline ($n{=}50$) and retail ($n{=}50$) splits.}}{6}{table.1}\protected@file@percent }
\newlabel{tab:headline}{{1}{6}{EchoKV preserves FP16 accuracy while reducing KV memory by $59$--$75\%$ across four workloads. \emph {Bits/rank} = per-TP-rank average at end of run with the controller live; \emph {Consolidated} = per-layer max across ranks. $\Delta $ is paired vs FP16 with McNemar exact $p$. $\tau $-Bench numbers merge airline ($n{=}50$) and retail ($n{=}50$) splits}{table.1}{}}
